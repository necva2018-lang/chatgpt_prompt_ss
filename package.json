{
  "name": "prompt-atelier",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "以卡片呈現的文字與圖片指令查詢器",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node website/server.cjs",
    "build": "node website/sync-data.cjs",
    "validate:data": "node database/validate-database.cjs",
    "test": "node --test website/tests/library.test.mjs scripts/media/cloudinary.test.cjs scripts/media/case-review.test.cjs",
    "check": "npm run validate:data && npm run image:progress:check && npm test",
    "export:github": "node scripts/export-github.cjs",
    "media:preview": "node scripts/cloudinary-media.cjs --preview",
    "media:upload": "node scripts/cloudinary-media.cjs --upload",
    "image:progress": "node scripts/image-case-progress.cjs",
    "image:progress:check": "node scripts/image-case-progress.cjs --check"
  }
}
